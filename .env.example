# Copia este archivo a .env.local y completa los valores desde Supabase > Connect.
# Variables necesarias para iniciar sesión con Google y acceder a las billeteras.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Usa la clave publica sb_publishable_..., nunca una secret key o service_role.
# El Client Secret de Google se configura en el proveedor Google de Supabase.
